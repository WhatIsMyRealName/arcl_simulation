<?xml version="1.0"?>
<!--
  Table Eurobot 3 m x 2 m avec ses bordures, 3 balises fixes cylindriques hors de la table,
  et un robot holonome à 4 roues omni aux coins, tournées de 45° (configuration en X).
  Le robot porte un lidar sur mât et une caméra frontale posée au ras du châssis et trois paires de ventouses sur ascenseur (une paire par carton d'une pile),
  montées sur un poignet qui fait tourner toute la pile de 0 à 90° autour de l'axe avant du robot (3 pierres couchées -> 3 pierres debout).
  Pierres de la Coupe de France / Eurobot 2027 (La légende de Camelot) dans leurs 10 carrières (3 pierres couchées empilées), ArUco 13 : modèle pierre_camelot (dossier models/).
  Repère monde : origine dans un coin intérieur de l'arène, X le long des 3 m, Y le long des 2 m, Z vers le haut.
  Écrit pour Gazebo Harmonic (gz sim) / ROS 2 Jazzy. Lancer : gz sim arene_omni.sdf
-->
<sdf version="1.9">
<world name="arene_omni">
  <physics name="1ms" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  
  <gravity>0 0 -9.81</gravity>
  
  <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background><grid>false</grid></scene>
  <light type="directional" name="soleil"><cast_shadows>true</cast_shadows><pose>1.5 1 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.2 -1</direction></light>
  
  
  
  <model name="sol"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
  <model name="table"><static>true</static><pose>1.5 1 0.0005 0 0 0</pose><link name="link"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>3 2</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.05 0.05 0.05 1</specular><pbr><metal><albedo_map>tapis_2027.png</albedo_map><metalness>0</metalness><roughness>0.9</roughness></metal></pbr></material></visual></link></model>
  
  
  <model name="murs">
  <static>true</static>
  <link name="link">
    <collision name="sud_c"><pose>1.5 -0.011 0.035 0 0 0</pose><geometry><box><size>3.044 0.022 0.07</size></box></geometry></collision>
    <visual name="sud_v"><pose>1.5 -0.011 0.035 0 0 0</pose><geometry><box><size>3.044 0.022 0.07</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    <collision name="nord_c"><pose>1.5 2.011 0.035 0 0 0</pose><geometry><box><size>3.044 0.022 0.07</size></box></geometry></collision>
    <visual name="nord_v"><pose>1.5 2.011 0.035 0 0 0</pose><geometry><box><size>3.044 0.022 0.07</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    <collision name="ouest_c"><pose>-0.011 1 0.035 0 0 0</pose><geometry><box><size>0.022 2 0.07</size></box></geometry></collision>
    <visual name="ouest_v"><pose>-0.011 1 0.035 0 0 0</pose><geometry><box><size>0.022 2 0.07</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    <collision name="est_c"><pose>3.011 1 0.035 0 0 0</pose><geometry><box><size>0.022 2 0.07</size></box></geometry></collision>
    <visual name="est_v"><pose>3.011 1 0.035 0 0 0</pose><geometry><box><size>0.022 2 0.07</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
  </link>
  </model>


  <model name="balise_1"><static>true</static><pose>-0.094 0.05 0.25 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
  <model name="balise_2"><static>true</static><pose>-0.094 1.95 0.25 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
  <model name="balise_3"><static>true</static><pose>3.094 1 0.25 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
  
  <!-- Obstacles de test, désactivés :
  <model name="obstacle1"><static>true</static><pose>1.5 1 0.25 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
  <model name="obstacle2"><static>true</static><pose>1.75 1 0.25 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
  -->


  <!-- Pierres Eurobot 2027 : 10 carrières, chacune avec 3 pierres couchées empilées (plan G.1 du règlement BETA 0.4).
       Boîtes carton 320 x 110 x 110 mm, ArUco 4x4_50 ID 13 (70 mm) sur les 4 grandes faces.
       Le modèle est debout (grand axe z) : pitch 1.5708 -> couché selon X, roll 1.5708 -> couché selon Y.
       Hauteurs 0.0551 / 0.1662 / 0.2773 : 1 mm de jeu entre pierres pour éviter les interpénétrations au démarrage. -->
  <include><uri>model://pierre_camelot</uri><name>pierre_centre_sud_1</name><pose>1.500 0.505 0.0551 1.5708 0 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_centre_sud_2</name><pose>1.500 0.505 0.1662 1.5708 0 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_centre_sud_3</name><pose>1.500 0.505 0.2773 1.5708 0 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_centre_nord_1</name><pose>1.500 1.495 0.0551 1.5708 0 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_centre_nord_2</name><pose>1.500 1.495 0.1662 1.5708 0 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_centre_nord_3</name><pose>1.500 1.495 0.2773 1.5708 0 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_1_1</name><pose>0.750 0.057 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_1_2</name><pose>0.750 0.057 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_1_3</name><pose>0.750 0.057 0.2773 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_2_1</name><pose>1.250 0.057 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_2_2</name><pose>1.250 0.057 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_2_3</name><pose>1.250 0.057 0.2773 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_3_1</name><pose>1.750 0.057 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_3_2</name><pose>1.750 0.057 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_3_3</name><pose>1.750 0.057 0.2773 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_4_1</name><pose>2.250 0.057 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_4_2</name><pose>2.250 0.057 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_sud_4_3</name><pose>2.250 0.057 0.2773 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_1_1</name><pose>0.750 1.943 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_1_2</name><pose>0.750 1.943 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_1_3</name><pose>0.750 1.943 0.2773 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_2_1</name><pose>1.250 1.943 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_2_2</name><pose>1.250 1.943 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_2_3</name><pose>1.250 1.943 0.2773 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_3_1</name><pose>1.750 1.943 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_3_2</name><pose>1.750 1.943 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_3_3</name><pose>1.750 1.943 0.2773 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_4_1</name><pose>2.250 1.943 0.0551 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_4_2</name><pose>2.250 1.943 0.1662 0 1.5708 0</pose></include>
  <include><uri>model://pierre_camelot</uri><name>pierre_bord_nord_4_3</name><pose>2.250 1.943 0.2773 0 1.5708 0</pose></include>

  <model name="robot_omni"><pose>0.25 1 0 0 0 0</pose>

    <!-- Repère robot : origine au centre des roues au niveau du sol, x vers l'avant, y vers la gauche. -->
    <!-- Masse châssis 8 kg et roues mu2 = 2 : plus d'adhérence, donc plus de poussée. -->
    <link name="chassis"><pose>0 0 0.045 0 0 0</pose><inertial><mass>8</mass><inertia><ixx>0.028333</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.028333</iyy><iyz>0</iyz><izz>0.053333</izz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.2 0.2 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.2 0.05</size></box></geometry><material><ambient>0.25 0.3 0.35 1</ambient><diffuse>0.25 0.3 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="avant"><pose>0.04 0 0.028 0 0 0</pose><geometry><box><size>0.04 0.02 0.006</size></box></geometry><material><ambient>0.9 0.15 0.15 1</ambient><diffuse>0.9 0.15 0.15 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="mat"><pose>0 0 0.205 0 0 0</pose><geometry><cylinder><radius>0.01</radius><length>0.36</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="lidar_v"><pose>0 0 0.385 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.385 0 0 0</pose><topic>scan</topic><gz_frame_id>lidar</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.08</min><max>8.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise></lidar></sensor>
      <sensor name="imu" type="imu"><topic>imu</topic><gz_frame_id>imu</gz_frame_id><update_rate>200</update_rate><always_on>true</always_on><imu><linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.01</bias_stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.01</bias_stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.01</bias_stddev></noise></z></linear_acceleration></imu></sensor>

      <!-- Support caméra : simple plaque de 3 mm vissée sur le dessus du châssis, à l'avant -->
      <visual name="support_cam_v"><pose>0.09 0 0.0265 0 0 0</pose><geometry><box><size>0.02 0.05 0.003</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>

      <!-- Boîtier caméra posé sur le support : centre optique à 8.55 cm du sol (dessus des roues à 6 cm) -->
      <visual name="cam_boitier"><pose>0.09 0 0.0405 0 0 0</pose><geometry><box><size>0.02 0.05 0.025</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name="cam_objectif"><pose>0.105 0 0.0405 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.01</length></cylinder></geometry><material><ambient>0.05 0.05 0.2 1</ambient><diffuse>0.05 0.05 0.2 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      <collision name="cam_c"><pose>0.09 0 0.039 0 0 0</pose><geometry><box><size>0.02 0.05 0.028</size></box></geometry></collision>

      <!-- Capteur caméra, axe optique horizontal -->
      <sensor name="camera" type="camera"><pose>0.11 0 0.0405 0 0 0</pose><topic>camera/image</topic><gz_frame_id>camera_optical</gz_frame_id><update_rate>30</update_rate><always_on>true</always_on><visualize>true</visualize>
        <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.02</near><far>10</far></clip><noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise></camera>
      </sensor>

      <!-- Supports et rails verticaux de l'ascenseur des ventouses (course 0 à 12 cm) -->
      <visual name="support_ventouse_g_v"><pose>0.09 0.045 0.0265 0 0 0</pose><geometry><box><size>0.02 0.03 0.003</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="rail_ventouse_g_v"><pose>0.078 0.045 0.144 0 0 0</pose><geometry><box><size>0.004 0.012 0.232</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="support_ventouse_d_v"><pose>0.09 -0.045 0.0265 0 0 0</pose><geometry><box><size>0.02 0.03 0.003</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="rail_ventouse_d_v"><pose>0.078 -0.045 0.144 0 0 0</pose><geometry><box><size>0.004 0.012 0.232</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    </link>

    <!-- Ascenseur des ventouses : glissière verticale (0 à 12 cm). Repère du link = repère du châssis, d'où les mêmes poses.
         Il porte le chariot et le servo du poignet. -->
    <link name="ascenseur"><pose>0 0 0.045 0 0 0</pose><inertial><pose>0.088 0 0.121 0 0 0</pose><mass>0.2</mass><inertia><ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0002</izz></inertia></inertial>
      <visual name="patin_g"><pose>0.078 0.045 0.121 0 0 0</pose><geometry><box><size>0.008 0.016 0.02</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name="patin_d"><pose>0.078 -0.045 0.121 0 0 0</pose><geometry><box><size>0.008 0.016 0.02</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name="chariot"><pose>0.083 0 0.121 0 0 0</pose><geometry><box><size>0.006 0.1 0.014</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="servo_poignet"><pose>0.092 0 0.121 0 0 0</pose><geometry><box><size>0.014 0.04 0.022</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <joint name="ascenseur_joint" type="prismatic"><parent>chassis</parent><child>ascenseur</child><axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0.12</upper></limit><dynamics><damping>1</damping></dynamics></axis></joint>

    <!-- Poignet : plaque avec 3 paires de ventouses, une paire par carton (centres à 5.5 / 16.6 / 27.7 cm du sol, ascenseur en bas),
         en face des 3 pierres empilées d'une carrière. Paires à y = +/-6 cm : la caméra voit entre elles.
         Le poignet tourne toute la plaque de 0 à 90° autour de l'axe x du robot, axe au centre du carton du milieu (x = 0.106, z = 0.121 dans le châssis).
         Repère du link = repère du châssis. À 90°, les 3 pierres sont debout côte à côte (pas de 11.1 cm selon y), leur bas à 6 mm du sol ascenseur en bas : le lâcher les pose toutes les 3.
         Ascenseur à 9.5 cm pour tourner : la pile (33 x 32 cm) passe à 3 cm du sol. -->
    <link name="poignet"><pose>0 0 0.045 0 0 0</pose><inertial><pose>0.13 0 0.121 0 0 0</pose><mass>0.15</mass><inertia><ixx>0.0008</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0008</iyy><iyz>0</iyz><izz>0.0002</izz></inertia></inertial>
      <visual name="palonnier"><pose>0.101 0 0.121 0 1.5708 0</pose><geometry><cylinder><radius>0.012</radius><length>0.004</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse><specular>0.5 0.5 0.5 1</specular></material></visual>
      <visual name="traverse"><pose>0.106 0 0.121 0 0 0</pose><geometry><box><size>0.008 0.14 0.012</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="montant_g"><pose>0.106 0.06 0.121 0 0 0</pose><geometry><box><size>0.008 0.008 0.25</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
