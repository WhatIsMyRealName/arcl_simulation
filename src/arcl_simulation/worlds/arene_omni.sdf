    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>map</odom_frame><robot_base_frame>base_link_vrai</robot_base_frame><odom_topic>/robot_omni/pose_vraie</odom_topic><tf_topic>/robot_omni/tf</tf_topic><dimensions>2</dimensions><odom_publish_frequency>100</odom_publish_frequency></plugin>
    <!-- Ascenseur piloté en position par un PID en force (50 N max). Pas de commandes en vitesse : avec des pierres collées
         qui touchent le sol, elles n'avaient plus d'effet (même problème que le poignet). Le terme intégral compense le poids. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>ascenseur_joint</joint_name><topic>/robot_omni/ascenseur/cmd_pos</topic><p_gain>300</p_gain><i_gain>200</i_gain><d_gain>30</d_gain><i_max>20</i_max><i_min>-20</i_min><cmd_max>50</cmd_max><cmd_min>-50</cmd_min></plugin>
    <!-- Poignet piloté en position par un PID en couple (2 N.m max), en radians (0 = pierres couchées, 1.5708 = pierres debout).
         Pas de commandes en vitesse ici : avec des pierres collées par le plugin Ventouse, elles n'avaient plus d'effet.
         gz topic -t /robot_omni/poignet/cmd_pos -m gz.msgs.Double -p 'data: 1.5708' -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>poignet_joint</joint_name><topic>/robot_omni/poignet/cmd_pos</topic><p_gain>3</p_gain><i_gain>0.5</i_gain><d_gain>0.25</d_gain><i_max>0.5</i_max><i_min>-0.5</i_min><cmd_max>2</cmd_max><cmd_min>-2</cmd_min></plugin>
    <!-- Ventouses (paquet ventouse_plugin) : une instance par étage (1 = carton du bas quand le poignet est à 0°).
         Chaque instance colle au poignet toute pierre à moins de 3 cm du centre de ses bouches (portee), sans contact :
         s'arrêter 1 à 2 cm devant la pile, ne pas la pousser.
         Pas de topic_ascenseur : c'est le nœud ROS ventouse_service qui monte et descend l'ascenseur pour les 3 étages.
         Services ROS : /robot_omni/ventouse/set (3 étages), /robot_omni/ventouse_<n>/set (un étage), /robot_omni/poignet/set. -->
    <plugin filename="Ventouse" name="ventouse::Ventouse"><link>poignet</link><collision>ventouse_1_g_c</collision><collision>ventouse_1_d_c</collision><topic_commande>/robot_omni/ventouse_1/commande</topic_commande><topic_resultat>/robot_omni/ventouse_1/resultat</topic_resultat><topic_etat>/robot_omni/ventouse_1/etat</topic_etat><fenetre_prise>0.2</fenetre_prise><portee>0.03</portee></plugin>
    <plugin filename="Ventouse" name="ventouse::Ventouse"><link>poignet</link><collision>ventouse_2_g_c</collision><collision>ventouse_2_d_c</collision><topic_commande>/robot_omni/ventouse_2/commande</topic_commande><topic_resultat>/robot_omni/ventouse_2/resultat</topic_resultat><topic_etat>/robot_omni/ventouse_2/etat</topic_etat><fenetre_prise>0.2</fenetre_prise><portee>0.03</portee></plugin>
    <plugin filename="Ventouse" name="ventouse::Ventouse"><link>poignet</link><collision>ventouse_3_g_c</collision><collision>ventouse_3_d_c</collision><topic_commande>/robot_omni/ventouse_3/commande</topic_commande><topic_resultat>/robot_omni/ventouse_3/resultat</topic_resultat><topic_etat>/robot_omni/ventouse_3/etat</topic_etat><fenetre_prise>0.2</fenetre_prise><portee>0.03</portee></plugin>
  
  </model>
